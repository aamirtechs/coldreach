# ColdReach environment configuration. Copy to .env for local development.
# Never commit a real .env file or real secrets.

# Database connection string.
# Local development uses SQLite. The path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Production target (PostgreSQL), for reference only:
# DATABASE_URL="postgresql://user:password@localhost:5432/coldreach?schema=public"

# Secret used to sign session JWT cookies. Use a long random value in real deployments.
SESSION_SECRET="replace-with-a-long-random-string"

# Base URL of the deployment, used in links and future email footers.
APP_URL="http://localhost:3000"

# Shared secret for the sending worker endpoint (POST /api/worker/tick,
# header x-worker-secret) and the worker:once scheduler setup.
WORKER_SECRET="replace-with-a-long-random-string"

# Shared secret for the provider event endpoint (POST /api/webhooks/events,
# header x-webhook-secret). When unset, the endpoint accepts WORKER_SECRET
# in the x-worker-secret header instead.
WEBHOOK_SECRET="replace-with-a-long-random-string"

# SMTP accounts store only a credentialRef in the database. The server
# resolves the ref as an environment prefix: for a ref of ACME_SMTP set
# ACME_SMTP_HOST, ACME_SMTP_PORT, ACME_SMTP_USER, ACME_SMTP_PASS and
# optionally ACME_SMTP_SECURE. Passwords never live in the database.
# ACME_SMTP_HOST="smtp.example.com"
# ACME_SMTP_PORT="587"
# ACME_SMTP_USER="sending-user"
# ACME_SMTP_PASS="replace-with-the-smtp-password"
