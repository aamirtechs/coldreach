# ColdReach environment configuration. Copy to .env for local development.
# Never commit a real .env file or real secrets.

# Database connection string.
# Local development uses SQLite. The path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Production target (PostgreSQL), for reference only:
# DATABASE_URL="postgresql://user:password@localhost:5432/coldreach?schema=public"

# Secret used to sign session JWT cookies. Use a long random value in real deployments.
SESSION_SECRET="replace-with-a-long-random-string"

# Base URL of the deployment, used in links and future email footers.
APP_URL="http://localhost:3000"

# Shared secret for the sending worker endpoint (POST /api/worker/tick,
# header x-worker-secret) and the worker:once scheduler setup.
WORKER_SECRET="replace-with-a-long-random-string"

# Shared secret for the provider event endpoint (POST /api/webhooks/events,
# header x-webhook-secret). When unset, the endpoint accepts WORKER_SECRET
# in the x-worker-secret header instead.
WEBHOOK_SECRET="replace-with-a-long-random-string"

# Phase 3: AES-256-GCM key used to encrypt OAuth tokens at rest.
# 32 random bytes, base64 encoded. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Without it, Gmail and Microsoft 365 connections cannot be stored.
ENCRYPTION_KEY=""

# Phase 3: bearer secret for the production cron endpoint
# (GET /api/cron/tick, header Authorization: Bearer <secret>).
# Vercel Cron sends CRON_SECRET automatically when it is set.
CRON_SECRET=""

# Phase 3: OAuth client credentials for mailbox connections.
# See INTEGRATIONS.md for the console steps that create these.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""

# Phase 4: AI assistance (optional). Without OPENAI_API_KEY the AI
# endpoints return 501 naming the variable and the UI shows
# "AI is not configured". AI_MODEL defaults to gpt-4o-mini.
# OPENAI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# Phase 4: Stripe billing (optional). Plans and quotas work without
# these via the FREE plan and the owner manual override on the
# Billing page. Set all of them to enable checkout, the customer
# portal, and webhook subscription sync. Setup steps are in
# INTEGRATIONS.md section 9.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_STARTER=""
# STRIPE_PRICE_PRO=""
# STRIPE_PRICE_AGENCY=""

# Phase 5 (optional): error tracking. When SENTRY_DSN is set, error
# level log entries are also forwarded to Sentry's envelope endpoint
# by the structured logger (src/lib/log.ts). Unset means log lines
# only go to stdout/stderr. LOG_LEVEL is one of debug, info, warn,
# error and defaults to info.
# SENTRY_DSN=""
# LOG_LEVEL="info"

# Phase 6 (optional): email verification provider. Without
# VERIFY_API_KEY the built-in checks (syntax, bundled partial
# disposable list, MX lookup) still run; with it, NeverBounce
# refines each verdict. Setup steps are in ACTIVATION.md section 6.
# VERIFY_API_KEY=""

# Phase 6 (optional): HubSpot CRM sync. Without these the HubSpot
# card in Settings names the missing variables and no connection is
# possible. With them, each workspace can connect its own HubSpot
# portal and push leads as contacts. Setup steps are in
# ACTIVATION.md section 8 and INTEGRATIONS.md section 10.
# HUBSPOT_CLIENT_ID=""
# HUBSPOT_CLIENT_SECRET=""

# SMTP accounts store only a credentialRef in the database. The server
# resolves the ref as an environment prefix: for a ref of ACME_SMTP set
# ACME_SMTP_HOST, ACME_SMTP_PORT, ACME_SMTP_USER, ACME_SMTP_PASS and
# optionally ACME_SMTP_SECURE. Passwords never live in the database.
# ACME_SMTP_HOST="smtp.example.com"
# ACME_SMTP_PORT="587"
# ACME_SMTP_USER="sending-user"
# ACME_SMTP_PASS="replace-with-the-smtp-password"
