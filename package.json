{
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "imapflow": "^2.9.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "mailparser": "^3.12.4",
    "next": "^15.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "description": "ColdReach, a cold email outreach platform for sales teams and lead generation agencies.",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.31",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2"
  },
  "name": "coldreach",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:vercel": "prisma generate --schema prisma/prod/schema.prisma && prisma migrate deploy --schema prisma/prod/schema.prisma && next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker:once": "tsx scripts/worker-once.ts"
  },
  "version": "1.8.4"
}
