// ColdReach core data model.
// Local development uses SQLite. The production target is PostgreSQL.
// The schema deliberately avoids provider-specific features so it stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  assignedThreads Thread[]  @relation("ThreadAssignee")
  threadNotes  ThreadNote[]
  invitesSent  Invite[]     @relation("InviteSender")
  apiKeysCreated ApiKey[]   @relation("ApiKeyCreator")
}

model Workspace {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  // Sender identity used in the compliance footer of every campaign email.
  // senderAddress is the postal address CAN-SPAM style rules require; the
  // campaign preflight refuses to launch while it is missing.
  senderName      String?
  senderAddress   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  sendingAccounts SendingAccount[]
  leadLists       LeadList[]
  leads           Lead[]
  campaigns       Campaign[]
  suppressions    Suppression[]
  threads         Thread[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  emailEvents     EmailEvent[]
  invites         Invite[]
  threadNotes     ThreadNote[]
  webhookEndpoints WebhookEndpoint[]
  subscription    Subscription?
  crmConnections  CrmConnection[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Sending infrastructure
// ---------------------------------------------------------------------------

enum SendingProvider {
  GMAIL
  MS365
  SMTP
  // Demo provider. Never touches the network; every surface that shows its
  // results labels them DEMO. Lets the product be evaluated end to end
  // without real mail credentials.
  SIMULATION
}

enum SendingAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PAUSED
}

enum WarmupStatus {
  OFF
  SIMULATED
  EXTERNAL
}

model SendingAccount {
  id             String               @id @default(cuid())
  workspaceId    String
  email          String
  displayName    String?
  provider       SendingProvider
  status         SendingAccountStatus @default(DISCONNECTED)
  dailyLimit     Int                  @default(50)
  warmupStatus   WarmupStatus         @default(OFF)
  // Phase 6 warm-up schedule. When warmupEnabled is true, the worker
  // additionally caps this account at the warm-up curve in
  // src/lib/domain/warmup.ts, counted from warmupStartedAt: 20 sends
  // a day in week 1, then 50, 100, 200, and the account's own
  // dailyLimit from day 29. warmupStatus above is the separate legacy
  // label for external/simulated warm-up services.
  warmupEnabled  Boolean              @default(false)
  warmupStartedAt DateTime?
  // Credentials are never stored in plain text. For SMTP this field
  // holds an opaque reference to server environment variables. OAuth
  // tokens (Phase 3) live in encryptedCredentials below, encrypted at
  // rest with AES-256-GCM; the plaintext never touches the database.
  credentialRef  String?
  // AES-256-GCM encrypted JSON blob holding OAuth access and refresh
  // tokens for GMAIL and MS365 accounts. Null until the account is
  // connected through the OAuth flow.
  encryptedCredentials String?
  // When the current OAuth access token expires. The provider layer
  // refreshes and rewrites encryptedCredentials before this passes.
  tokenExpiresAt DateTime?
  // Last successful reply sync for this account, and the opaque cursor
  // the sync source resumes from (Gmail history id, Graph timestamp).
  lastSyncAt     DateTime?
  syncCursor     String?
  // The account's id at the provider (Google sub, Microsoft account id).
  providerAccountId String?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threads        Thread[]
  emailEvents    EmailEvent[]
  campaigns      CampaignAccount[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  VALID
  INVALID
  UNSUBSCRIBED
  BOUNCED
  SUPPRESSED
}

// Phase 6 email verification outcome, distinct from LeadStatus (which
// tracks contact state). Set by the verifier in src/lib/verify/ and
// read at campaign enrollment: INVALID leads never enroll.
enum LeadVerificationStatus {
  UNKNOWN
  VALID
  RISKY
  INVALID
}

model LeadList {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]
  campaigns   Campaign[]

  @@index([workspaceId])
}

model Lead {
  id          String       @id @default(cuid())
  workspaceId String
  listId      String?
  email       String
  // Arbitrary contact attributes imported from CSV or added by hand,
  // for example firstName, company, role. Stored as JSON for portability.
  // Application code supplies {} on create; a database level default is
  // avoided because SQLite cannot express a JSON literal default portably.
  fields      Json
  status      LeadStatus   @default(NEW)
  // Phase 6 verification. verificationDetail is the JSON evidence the
  // verifier recorded (syntax, disposable, MX, provider result);
  // verifiedAt is when the check ran. Both are null until the lead is
  // verified, and verificationStatus starts UNKNOWN.
  verificationStatus LeadVerificationStatus @default(UNKNOWN)
  verificationDetail Json?
  verifiedAt  DateTime?
  // Tag labels, stored as a JSON array of strings. Application code
  // supplies [] on create, for the same portability reason as fields.
  tags        Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list        LeadList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  threads     Thread[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

// ---------------------------------------------------------------------------
// Campaigns, sequences, enrollments
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  ARCHIVED
}

model Campaign {
  id               String         @id @default(cuid())
  workspaceId      String
  name             String
  status           CampaignStatus @default(DRAFT)
  // The lead list this campaign sends to. Enrollment reads from this list.
  leadListId       String?
  timezone         String         @default("UTC")
  // Local sending window, "HH:MM" 24 hour values in the campaign timezone.
  windowStart      String         @default("09:00")
  windowEnd        String         @default("17:00")
  businessDaysOnly Boolean        @default(true)
  // Optional per-campaign email signature (plain text, may use the
  // lead personalisation tokens). The worker renders it between the
  // step body and the compliance footer on every send, so editing it
  // never rewrites sequence steps and applies from the next send on.
  signatureText    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadList         LeadList?      @relation(fields: [leadListId], references: [id], onDelete: SetNull)
  accounts         CampaignAccount[]
  steps            SequenceStep[]
  enrollments      Enrollment[]
  threads          Thread[]
  emailEvents      EmailEvent[]

  @@index([workspaceId, status])
}

// Join between a campaign and the sending accounts it may send from.
// The worker rotates across these accounts in createdAt order.
model CampaignAccount {
  id               String         @id @default(cuid())
  campaignId       String
  sendingAccountId String
  createdAt        DateTime       @default(now())
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sendingAccount   SendingAccount @relation(fields: [sendingAccountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sendingAccountId])
  @@index([campaignId])
}

model SequenceStep {
  id         String   @id @default(cuid())
  campaignId String
  order      Int
  delayDays  Int      @default(0)
  delayHours Int      @default(0)
  subject    String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants   StepVariant[]

  @@unique([campaignId, order])
  @@index([campaignId])
}

// An A/B test variant of a sequence step. The step's own subject and
// body are always variant "A"; rows here are the additional variants
// (labels B, C), at most two per step, enforced by the builder API.
// A null subject means the variant reuses the step's subject. The
// worker picks a variant deterministically per enrollment and step
// (see src/lib/domain/abtest.ts) and records the label on the send
// event, so analytics can attribute outcomes to the exact copy sent.
model StepVariant {
  id        String   @id @default(cuid())
  stepId    String
  label     String
  subject   String?
  bodyText  String
  bodyHtml  String?
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  step      SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, label])
  @@index([stepId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  UNSUBSCRIBED
  BOUNCED
  COMPLETED
  SUPPRESSED
}

model Enrollment {
  id          String           @id @default(cuid())
  campaignId  String
  leadId      String
  currentStep Int              @default(0)
  status      EnrollmentStatus @default(ACTIVE)
  nextSendAt  DateTime?
  // Last provider error for a failed send attempt, shown to the user.
  lastError   String?
  enrolledAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailEvents EmailEvent[]

  // Hard guarantee against duplicate enrollment of the same lead.
  @@unique([campaignId, leadId])
  @@index([status, nextSendAt])
  // Phase 5: campaign-scoped due-send scans (worker + list views).
  @@index([campaignId, status, nextSendAt])
}

// ---------------------------------------------------------------------------
// Email events and suppression
// ---------------------------------------------------------------------------

enum EmailEventType {
  SENT
  // A send attempt that the provider rejected or could not complete.
  // Recorded so failures are visible and auditable; never counted as sent.
  FAILED
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
}

model EmailEvent {
  id               String         @id @default(cuid())
  workspaceId      String
  campaignId       String?
  enrollmentId     String?
  sendingAccountId String?
  type             EmailEventType
  // Provider assigned message identifier, when the provider supplies one.
  providerMessageId String?
  // Unique per logical event so webhook retries and provider redeliveries
  // can be deduplicated safely.
  idempotencyKey   String         @unique
  // Optional reply classification, for example POSITIVE, NEUTRAL, NEGATIVE.
  classification   String?
  // A/B test variant label (A, B, C) of the step copy this event
  // belongs to, set on SENT and FAILED events when the worker sends.
  // Null on events recorded before variant tracking and on events
  // that carry no copy (the analytics layer reads null as variant A).
  variant          String?
  occurredAt       DateTime
  createdAt        DateTime       @default(now())
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  enrollment       Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  sendingAccount   SendingAccount? @relation(fields: [sendingAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
  @@index([campaignId, type])
  // Phase 5: time-ordered workspace event reads (usage windows,
  // recent activity) without scanning by type first.
  @@index([workspaceId, createdAt])
}

enum SuppressionScope {
  WORKSPACE
  GLOBAL
}

model Suppression {
  id          String           @id @default(cuid())
  // Null workspaceId means a global entry that applies to every workspace.
  workspaceId String?
  scope       SuppressionScope @default(WORKSPACE)
  // Exactly one of email or domain is set.
  email       String?
  domain      String?
  reason      String
  createdAt   DateTime         @default(now())
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([domain])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Unified inbox
// ---------------------------------------------------------------------------

enum ThreadStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Thread {
  id               String         @id @default(cuid())
  workspaceId      String
  campaignId       String?
  leadId           String?
  sendingAccountId String?
  assigneeId       String?
  subject          String
  status           ThreadStatus   @default(OPEN)
  // Maintained by reply sync: set when a new inbound message lands,
  // cleared when a member opens the conversation.
  unread           Boolean        @default(false)
  // Latest reply classification from the rules engine in
  // src/lib/domain/classify.ts (POSITIVE, NEGATIVE, OUT_OF_OFFICE,
  // REFERRAL, NEUTRAL), or a member's manual override.
  classification   String?
  lastMessageAt    DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead             Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sendingAccount   SendingAccount? @relation(fields: [sendingAccountId], references: [id], onDelete: SetNull)
  assignee         User?          @relation("ThreadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages         ThreadMessage[]
  notes            ThreadNote[]

  @@index([workspaceId, status])
  // Phase 5: inbox lists sort by recency inside a status filter.
  @@index([workspaceId, status, updatedAt])
}

model ThreadMessage {
  id        String           @id @default(cuid())
  threadId  String
  direction MessageDirection
  fromEmail String
  toEmail   String
  subject   String?
  body      String
  // The provider's id for this message, when known. Reply sync uses it
  // to stay idempotent: a message already imported is never appended
  // twice, however often sync runs.
  providerMessageId String?
  occurredAt DateTime        @default(now())
  createdAt DateTime         @default(now())
  thread    Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, occurredAt])
  @@index([providerMessageId])
}

// Internal note on a conversation. Notes are visible only inside the
// workspace and are never sent to the contact or the provider.
model ThreadNote {
  id          String   @id @default(cuid())
  workspaceId String
  threadId    String
  authorId    String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Audit and API access
// ---------------------------------------------------------------------------

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  metadata    Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// A pending invitation to join a workspace with a preset role. Only the
// SHA-256 hash of the accept token is stored; the plaintext token exists
// only in the accept link the workspace owner shares (and optionally in
// the invitation email, when an SMTP account sends one).
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // Only a hash of the key is stored, plus a short display prefix
  // (the first 10 characters of the full key, shown in the UI).
  keyHash     String    @unique
  prefix      String
  // Granted scopes as a JSON array of strings, for example
  // ["leads:read", "leads:write"]. Application code supplies the
  // array on create; there is no database level default, matching
  // the Lead JSON portability note above.
  scopes      Json
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Outbound webhooks (Phase 4)
// ---------------------------------------------------------------------------

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  // HMAC signing secret, stored only as AES-256-GCM ciphertext via
  // the crypto helper, the same discipline as OAuth tokens. The
  // plaintext is shown exactly once, at creation.
  secret      String
  // Event types this endpoint subscribes to, as a JSON array of
  // strings (REPLIED, BOUNCED, UNSUBSCRIBED, COMPLAINED, DELIVERED).
  eventTypes  Json
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  eventType      String
  // The exact JSON body posted to the endpoint, stored for the
  // delivery log and for signature verification by the receiver.
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// CRM connections (Phase 6)
// ---------------------------------------------------------------------------

// A workspace's connection to an external CRM. Today the only provider
// is HubSpot ("HUBSPOT"). OAuth tokens live only in
// encryptedCredentials (AES-256-GCM, same helper and discipline as
// mailbox OAuth and webhook secrets); the plaintext never touches the
// database. lastSyncSummary holds the JSON summary of the most recent
// sync run recorded by src/lib/crm/hubspot.ts.
model CrmConnection {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String
  status               String    @default("DISCONNECTED")
  encryptedCredentials String?
  // The account id at the provider (HubSpot portal id).
  externalAccountId    String?
  lastSyncAt           DateTime?
  lastSyncSummary      Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Billing (Phase 4)
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  STARTER
  PRO
  AGENCY
}

// One subscription row per workspace, created lazily on the FREE plan.
// The plan catalog itself (limits and prices) lives in
// src/lib/domain/plans.ts; this row records which plan the workspace
// is on and the Stripe linkage once billing is configured.
model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  plan                 PlanTier  @default(FREE)
  status               String    @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
